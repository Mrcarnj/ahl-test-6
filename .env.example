# Web build only. Points at the Cloudflare Worker's iCal proxy endpoint, which
# fetches a user's HorizonWebRef feed server-side so the browser is not blocked
# by CORS. The native app fetches the feed directly and ignores this.
#
# Deploy cloudflare-worker/ and use its URL + /ical:
EXPO_PUBLIC_ICAL_PROXY_URL=https://ahl-ical-proxy.<your-subdomain>.workers.dev/ical

# NOTE: EXPO_PUBLIC_* values are inlined into the bundle at transform time and
# the result is cached by Metro. After changing this file, restart with a
# cleared cache or the old value (or `undefined`) is silently baked in:
#   npm run web -- --clear
# `npm run web:export` already passes --clear.

# Public web origin. Used for the Privacy Policy / Terms links.
EXPO_PUBLIC_SITE_URL=https://ahl-officials.expo.app
