{
  "expo": {
    "name": "AHL Officials",
    "slug": "ahl-test-6",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dieter15.ahltest6",
      "infoPlist": {
        "NSContactsUsageDescription": "Allow AHL Officials to access your contacts to add officials' contact information.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "background-fetch",
          "background-fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dieter15.ahltest6",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "AHL Officials",
      "shortName": "AHL Officials",
      "backgroundColor": "#000000",
      "themeColor": "#000000",
      "description": "Schedules, team rosters and standings for American Hockey League officials.",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-contacts",
      "expo-background-fetch",
      "expo-task-manager",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AHL Officials to access your videos so you can upload game clips for your crew.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d1103638-3c9e-4c41-8846-38a4a1486029"
      }
    }
  }
}
